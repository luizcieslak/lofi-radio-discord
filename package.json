{
	"name": "lofi-radio-discord",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"description": "A resilient 24/7 Discord voice relay for lofi-radio.",
	"engines": {
		"node": ">=24.17.0"
	},
	"scripts": {
		"start": "node src/index.ts",
		"dev": "node --env-file-if-exists=.env --watch src/index.ts",
		"typecheck": "tsc --noEmit",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"test": "node --test src/config.test.ts src/retry.test.ts src/runtimeStatus.test.ts",
		"check": "npm run typecheck && npm run lint && npm test"
	},
	"dependencies": {
		"@discordjs/voice": "0.19.2",
		"close-with-grace": "2.5.0",
		"discord.js": "14.27.0",
		"zod": "4.6.2"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.13",
		"@types/node": "24.13.4",
		"typescript": "7.0.2"
	}
}
